# Copy to .env. scripts/start.ps1 and scripts/start.sh generate distinct tokens when these are empty.
SOLSWARM_ADMIN_TOKEN=
SOLSWARM_MONITOR_TOKEN=

# demo uses labeled fixtures. live reads providers and keeps a separate paper book.
SOLSWARM_MODE=demo
SOLSWARM_DATABASE_URL=sqlite:///./data/solswarm.db
SOLSWARM_HOST=127.0.0.1
SOLSWARM_PORT=8000
SOLSWARM_AUTOSTART=true
SOLSWARM_SCAN_INTERVAL_SECONDS=60
SOLSWARM_AGENT_TIMEOUT_SECONDS=8

# Public RPC is rate limited. Replace with your own endpoint if scans time out.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# GMGN OpenAPI (read-only market, trending, kline, security, and paper quote lookups).
# Create a read-only API key at https://gmgn.ai/ai. Do NOT supply a trading signing key;
# live swap execution is disabled in this application.
GMGN_API_KEY=
GMGN_BASE_URL=https://openapi.gmgn.ai

# TypeSafe System One (JEV typed noul / choice / score judgements).
# Optional. Without TYPESAFE_API_KEY, the desk displays JEV NOT CONNECTED and runs deterministic rules.
TYPESAFE_API_KEY=
TYPESAFE_DEFAULT_MODEL=jev-latest
TYPESAFE_BASE_URL=https://api.typesafe.ai

# Optional secondary quote / enrichment / commentary credentials.
# Jupiter Swap v2 /order is used for quotes only; any transaction field is stripped.
JUPITER_API_KEY=
BIRDEYE_API_KEY=
XAI_API_KEY=
XAI_MODEL=grok-4-fast
XAI_BASE_URL=https://api.x.ai/v1
SOLSWARM_AI_HOURLY_BUDGET=20
