# Copy to .env. scripts/start.ps1 and scripts/start.sh generate distinct tokens when these are empty.
# SOL SWARM Zero-Additional-Cost Architecture ($0.00/mo required extra spend).
SOLSWARM_ADMIN_TOKEN=
SOLSWARM_MONITOR_TOKEN=
# Optional dedicated token for Grok Bot MCP teammates (SCAN, VET, SOCIAL, CHIEF) over Tailscale Serve.
SOLSWARM_MCP_TOKEN=
SOLSWARM_MCP_ENABLED=true
SOLSWARM_GROK_BOT_FRESHNESS_SECONDS=180

# demo uses labeled fixtures. live reads real GMGN/DEX providers and keeps a separate paper book.
# All historical market observations, candlesticks/klines, and replay runs stay in local SQLite.
SOLSWARM_MODE=demo
SOLSWARM_DATABASE_URL=sqlite:///./data/solswarm.db
SOLSWARM_HOST=127.0.0.1
SOLSWARM_PORT=8000
SOLSWARM_AUTOSTART=true
SOLSWARM_SCAN_INTERVAL_SECONDS=60
SOLSWARM_AGENT_TIMEOUT_SECONDS=8

# Public RPC is free & rate limited. Replace with your own free endpoint if scans time out.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# GMGN OpenAPI (read-only market, trending, kline, security, and paper quote lookups — $0 Free key supported).
# Create a read-only API key at https://gmgn.ai/ai. Do NOT supply a trading signing key;
# live swap execution is permanently disabled in this application.
GMGN_API_KEY=
GMGN_BASE_URL=https://openapi.gmgn.ai

# Supabase Free shared coordination (optional; falls back to local SQLite when empty).
# Stores ONLY compact tasks, findings, heartbeats, structured decisions, and summary snapshot (<500 MB Free limit).
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SOLSWARM_SUPABASE_LIMIT_BYTES=524288000
SOLSWARM_SUPABASE_TASK_TTL_HOURS=24
SOLSWARM_SUPABASE_FINDING_TTL_HOURS=72
SOLSWARM_SUPABASE_DECISION_TTL_DAYS=14
SOLSWARM_SUPABASE_HEARTBEAT_TTL_HOURS=24
SOLSWARM_SUPABASE_MAX_PAYLOAD_BYTES=4096

# Optional Paid Integrations — STRICTLY DISABLED BY DEFAULT ($0.00/mo required).
# TypeSafe System One (JEV) is not required; Grok Bot + local deterministic fallback handle analysis.
SOLSWARM_ENABLE_OPTIONAL_JEV=false
TYPESAFE_API_KEY=
TYPESAFE_DEFAULT_MODEL=jev-latest
TYPESAFE_BASE_URL=https://api.typesafe.ai

# Optional secondary quote / commentary credentials (not required).
JUPITER_API_KEY=
BIRDEYE_API_KEY=
XAI_API_KEY=
XAI_MODEL=grok-4-fast
XAI_BASE_URL=https://api.x.ai/v1
SOLSWARM_AI_HOURLY_BUDGET=20
