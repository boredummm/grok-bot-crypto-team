# Copy to .env. scripts/start.ps1 and scripts/start.sh generate distinct tokens when these are empty.
SOLSWARM_ADMIN_TOKEN=
SOLSWARM_MONITOR_TOKEN=

# demo uses labeled fixtures. live reads providers and keeps a separate paper book.
SOLSWARM_MODE=demo
SOLSWARM_DATABASE_URL=sqlite:///./data/solswarm.db
SOLSWARM_HOST=127.0.0.1
SOLSWARM_PORT=8000
SOLSWARM_AUTOSTART=true
SOLSWARM_SCAN_INTERVAL_SECONDS=60
SOLSWARM_AGENT_TIMEOUT_SECONDS=8

# Public RPC is rate limited. Replace with your own endpoint if scans time out.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Optional. Without these, the related capability is shown as unavailable.
# Jupiter is required for live executable quotes. The app requests /swap/v2/order and discards the transaction.
JUPITER_API_KEY=
BIRDEYE_API_KEY=
XAI_API_KEY=
XAI_MODEL=grok-4-fast
XAI_BASE_URL=https://api.x.ai/v1
SOLSWARM_AI_HOURLY_BUDGET=20
